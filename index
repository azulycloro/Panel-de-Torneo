/* =====================================================================
   TABLA GENÉRICA (orden + búsqueda + export state)
===================================================================== */
function buildDataTable(container, {rows, columns, sortKey, sortDir='asc', onSort, rowClassFn, emptyMsg}){
  if(!rows || rows.length===0){
    container.innerHTML = `<div class="empty-state">${icon('empty')}<b>Sin datos para mostrar</b>${emptyMsg||'Ajusta los filtros o espera a que se carguen resultados.'}</div>`;
    return;
  }
  let html = '<div class="table-wrap"><table class="data"><thead><tr>';
  columns.forEach(c=>{
    const sorted = c.key===sortKey;
    html += `<th data-key="${c.key}" class="${sorted?'sorted':''}">${escapeHtml(c.label)}<span class="arrow">${sorted ? (sortDir==='asc'?'▲':'▼') : '↕'}</span></th>`;
  });
  html += '</tr></thead><tbody>';
  rows.forEach(row=>{
    const cls = rowClassFn ? rowClassFn(row) : '';
    html += `<tr class="${cls}">`;
    columns.forEach(c=>{
      const raw = row[c.key];
      const val = c.render ? c.render(raw, row) : escapeHtml(raw);
      html += `<td class="${c.mono?'mono':''}">${val==='' || val===undefined ? '—' : val}</td>`;
    });
    html += '</tr>';
  });
  html += '</tbody></table></div>';
  container.innerHTML = html;
  container.querySelectorAll('thead th').forEach(th=>{
    th.addEventListener('click', ()=> onSort(th.dataset.key));
  });
}
function sortRows(rows, key, dir, columns){
  const colDef = columns.find(c=>c.key===key);
  const sorted = [...rows].sort((a,b)=>{
    let av = a[key], bv = b[key];
    if(colDef && colDef.sortValue){ av = colDef.sortValue(a); bv = colDef.sortValue(b); }
    const an = parseFloat(norm(av).replace(',', '.').replace(/[^0-9.\-]/g,''));
    const bn = parseFloat(norm(bv).replace(',', '.').replace(/[^0-9.\-]/g,''));
    const bothNum = !isNaN(an) && !isNaN(bn) && colDef && colDef.numeric;
    let cmp;
    if(bothNum) cmp = an - bn;
    else cmp = norm(av).localeCompare(norm(bv), 'es', {numeric:true, sensitivity:'base'});
    return dir==='asc' ? cmp : -cmp;
  });
  return sorted;
}

