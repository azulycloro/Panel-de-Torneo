async function renderResultados(kind){
  const pageId = kind==='ind' ? 'individuales' : 'relevos';
  const tabNames = kind==='ind' ? [CFG.ind] : [CFG.rel];
  const el = document.getElementById('page-'+pageId);
  el.innerHTML = `<div class="loading-row">Cargando resultados…</div>`;
  try{
    const {name, rows} = await fetchTabAny(tabNames);
    if(!rows.length) throw new Error('La pestaña "'+name+'" está vacía.');
    const sample = rows[0];
    const genderKey = findKey(sample, ['genero','género','sexo']);
    const pruebaKey = findKey(sample, ['prueba']);
    const equipoKey = findKey(sample, ['equipo']);
    const lugarKey = findKey(sample, ['lugar','puesto']);
    const finalKey = findKey(sample, ['final']);

    el.innerHTML = `
      <div class="filters-bar">
        ${genderKey ? `<div class="filter-group"><label>Género</label><select id="${pageId}Genero"><option value="">Todos</option><option>Femenino</option><option>Masculino</option></select></div>`:''}
        ${pruebaKey ? `<div class="filter-group"><label>Prueba</label><select id="${pageId}Prueba"></select></div>`:''}
        ${equipoKey ? `<div class="filter-group"><label>Equipo</label><select id="${pageId}Equipo"></select></div>`:''}
        <div class="search-wrap">${icon('search')}<input type="text" id="${pageId}Search" placeholder="Buscar nadador, equipo o prueba…"></div>
      </div>
      <div class="panel"><div id="${pageId}Table"></div>
        <div class="foot-note">Fuente: pestaña “${escapeHtml(name)}” · ${rows.length} registros cargados.</div>
      </div>`;

    if(pruebaKey){
      const vals = [...new Set(rows.map(r=>norm(r[pruebaKey])).filter(Boolean))].sort();
      document.getElementById(pageId+'Prueba').innerHTML = '<option value="">Todas</option>'+vals.map(v=>`<option>${escapeHtml(v)}</option>`).join('');
    }
    if(equipoKey){
      const vals = [...new Set(rows.map(r=>norm(r[equipoKey])).filter(Boolean))].sort();
      document.getElementById(pageId+'Equipo').innerHTML = '<option value="">Todos</option>'+vals.map(v=>`<option>${escapeHtml(v)}</option>`).join('');
    }

    // Orden de columnas "tal cual" la hoja de origen. Si la pestaña real trae
    // exactamente estos encabezados (Género, Prueba, Lugar, Nombre, Equipo,
    // Edad, Final, Mejora, T(seg), PWA, Puntos, Sembrado) se respeta ese
    // orden; cualquier columna adicional no contemplada se agrega al final,
    // y si falta alguna simplemente no se muestra.
    const PREFERRED_ORDER = kind==='ind'
      ? ['Género','Prueba','Lugar','Nombre','Equipo','Edad','Final','Mejora','T(seg)','PWA','Puntos','Sembrado']
      : null;

    function colDef(k){
      const isTime = k===finalKey;
      const isMejora = k===mejoraKey;
      const numericHeaders = ['t(seg)','pwa','puntos','lugar','mejora','edad'];
      const isNumeric = numericHeaders.some(h=>stripAccents(k).includes(h));
      return {
        key:k, label:k, numeric:isNumeric, mono:isNumeric||isTime,
        render:(v)=>{
          if(k===finalKey){
            const st = statusFromFinal(v);
            if(st==='DQ') return `<span class="tag dq">DQ</span>`;
            if(st==='DNS') return `<span class="tag ns">${escapeHtml(v)}</span>`;
            return v==='' ? '' : `<span class="mono">${escapeHtml(v)}</span>`;
          }
          if(isMejora){
            const t = norm(v);
            if(t==='--' || t==='') return `<span style="color:var(--muted);">--</span>`;
            const cls = t.startsWith('-') ? 'impr-good' : (t.startsWith('+') ? 'impr-bad' : '');
            return `<span class="${cls}">${escapeHtml(t)}</span>`;
          }
          return escapeHtml(v);
        }
      };
    }

    const mejoraKey = findKey(sample, ['mejora']);
    let columns;
    if(PREFERRED_ORDER){
      const seen = new Set();
      columns = PREFERRED_ORDER.map(label=>{
        const k = findKey(sample, [label]);
        if(k) seen.add(k);
        return k ? colDef(k) : null;
      }).filter(Boolean);
      Object.keys(sample).forEach(k=>{ if(!seen.has(k)) columns.push(colDef(k)); });
    } else {
      columns = Object.keys(sample).map(colDef);
    }

    const sortState = {key: lugarKey || columns[0].key, dir:'asc'};
    function apply(){
      let filtered = [...rows];
      if(genderKey){ const g=document.getElementById(pageId+'Genero').value; if(g) filtered = filtered.filter(r=>norm(r[genderKey])===g); }
      if(pruebaKey){ const p=document.getElementById(pageId+'Prueba').value; if(p) filtered = filtered.filter(r=>norm(r[pruebaKey])===p); }
      if(equipoKey){ const eq=document.getElementById(pageId+'Equipo').value; if(eq) filtered = filtered.filter(r=>norm(r[equipoKey])===eq); }
      const q = stripAccents(document.getElementById(pageId+'Search').value);
      if(q) filtered = filtered.filter(r=> Object.values(r).some(v=>stripAccents(v).includes(q)));

      filtered = sortRows(filtered, sortState.key, sortState.dir, columns);
      buildDataTable(document.getElementById(pageId+'Table'), {
        rows:filtered, columns, sortKey:sortState.key, sortDir:sortState.dir,
        rowClassFn:(r)=>{
          const cls=[]; 
          if(lugarKey){ const m=medalFromLugar(r[lugarKey]); if(m) cls.push(m); }
          if(finalKey && statusFromFinal(r[finalKey])==='DQ') cls.push('dq');
          return cls.join(' ');
        },
        onSort:(k)=>{ sortState.dir=(sortState.key===k && sortState.dir==='asc')?'desc':'asc'; sortState.key=k; apply(); }
      });
      setExport(filtered, columns, kind==='ind' ? 'resultados_individuales' : 'resultados_relevos');
    }
    [pageId+'Genero', pageId+'Prueba', pageId+'Equipo', pageId+'Search'].forEach(id=>{
      const elm = document.getElementById(id);
      if(elm){ elm.addEventListener('input', apply); elm.addEventListener('change', apply); }
    });
    apply();
  }catch(e){
    el.innerHTML = errorBlock(kind==='ind'?'resultados individuales':'resultados relevos', tabNames, e);
  }
}

