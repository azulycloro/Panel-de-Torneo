<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Torneo · Panel de Resultados</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
:root{
  --navy:#0E2233;
  --navy-2:#123049;
  --deck:#F2F6F8;
  --panel:#FFFFFF;
  --line-blue:#1C7FA6;
  --line-blue-dark:#0F6486;
  --live:#E8543A;
  --gold:#B8912B;
  --silver:#8C97A1;
  --bronze:#AD6A2E;
  --ink:#0F1F2B;
  --ink-2:#3C5064;
  --muted:#7288A2;
  --border:#DCE6EB;
  --border-2:#EDF2F5;
  --ok:#1E8F6B;
  --warn:#C1531E;
  --radius:10px;
  --font-d:'Space Grotesk',sans-serif;
  --font-b:'IBM Plex Sans',sans-serif;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:var(--font-b);
  color:var(--ink);
  background:var(--deck);
  font-size:14px;
  -webkit-font-smoothing:antialiased;
}
button{font-family:inherit;cursor:pointer;}
input,select{font-family:inherit;}
::selection{background:var(--line-blue);color:#fff;}
.app{display:flex;min-height:100vh;}

/* ---------- SIDEBAR ---------- */
.sidebar{
  width:248px;flex:0 0 248px;
  background:var(--navy);
  color:#CBD9E3;
  display:flex;flex-direction:column;
  transition:width .22s ease, flex-basis .22s ease;
  position:relative;z-index:20;
}
.sidebar.collapsed{width:72px;flex-basis:72px;}
.sb-head{
  display:flex;align-items:center;gap:10px;
  padding:20px 18px;border-bottom:1px solid rgba(255,255,255,.08);
  min-height:32px;
}
.sb-mark{
  width:34px;height:34px;border-radius:9px;flex:0 0 34px;
  background:linear-gradient(155deg,var(--line-blue),var(--line-blue-dark));
  display:flex;align-items:center;justify-content:center;
}
.sb-title{font-family:var(--font-d);font-weight:700;font-size:15.5px;color:#fff;line-height:1.15;white-space:nowrap;overflow:hidden;}
.sb-title small{display:block;font-family:var(--font-b);font-weight:500;font-size:11px;color:#7EA1B7;letter-spacing:.01em;}
.sidebar.collapsed .sb-title{display:none;}
.sb-toggle{
  margin-left:auto;background:transparent;border:0;color:#8FADBF;
  width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;flex:0 0 28px;
}
.sb-toggle:hover{background:rgba(255,255,255,.08);color:#fff;}
.sidebar.collapsed .sb-head{padding:20px 0;justify-content:center;}
.sidebar.collapsed .sb-toggle{margin-left:0;}

.nav{flex:1;padding:14px 10px;display:flex;flex-direction:column;gap:3px;overflow-y:auto;}
.nav-item{
  display:flex;align-items:center;gap:12px;
  padding:10px 12px;border-radius:8px;border:0;background:transparent;
  color:#AEC3D2;text-align:left;font-size:13.5px;font-weight:500;
  white-space:nowrap;overflow:hidden;
}
.nav-item svg{flex:0 0 18px;width:18px;height:18px;}
.nav-item span{overflow:hidden;text-overflow:ellipsis;}
.nav-item:hover{background:rgba(255,255,255,.06);color:#fff;}
.nav-item.active{background:rgba(28,127,166,.28);color:#fff;box-shadow:inset 3px 0 0 var(--line-blue);}
.sidebar.collapsed .nav-item{justify-content:center;padding:11px 0;}
.sidebar.collapsed .nav-item span{display:none;}

.sb-foot{padding:14px 16px;border-top:1px solid rgba(255,255,255,.08);font-size:11.5px;color:#6E8EA2;}
.sb-foot a{color:#9CC2D6;text-decoration:none;}
.sb-foot .live-row{display:flex;align-items:center;gap:7px;margin-bottom:8px;color:#B9CCD8;font-weight:500;}
.dot{width:7px;height:7px;border-radius:50%;background:var(--live);flex:0 0 7px;}
.dot.pulse{animation:pulse 1.6s infinite;}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(232,84,58,.55);}70%{box-shadow:0 0 0 6px rgba(232,84,58,0);}100%{box-shadow:0 0 0 0 rgba(232,84,58,0);}}
.sidebar.collapsed .sb-foot{display:none;}
.gear-btn{background:transparent;border:1px solid rgba(255,255,255,.15);color:#9CC2D6;border-radius:7px;padding:6px 8px;font-size:11.5px;display:flex;align-items:center;gap:6px;width:100%;justify-content:center;}
.gear-btn:hover{background:rgba(255,255,255,.08);}

/* ---------- MAIN ---------- */
.main{flex:1;min-width:0;display:flex;flex-direction:column;}
.topbar{
  background:var(--panel);border-bottom:1px solid var(--border);
  padding:16px 26px;display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;
  position:sticky;top:0;z-index:10;
}
.topbar h1{font-family:var(--font-d);font-size:21px;margin:0 0 3px;color:var(--navy);letter-spacing:-.01em;}
.topbar p{margin:0;color:var(--muted);font-size:12.5px;}
.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
.btn{
  display:flex;align-items:center;gap:7px;
  border:1px solid var(--border);background:#fff;color:var(--ink-2);
  padding:8px 13px;border-radius:8px;font-size:12.5px;font-weight:600;
}
.btn svg{width:15px;height:15px;flex:0 0 15px;}
.btn:hover{border-color:var(--line-blue);color:var(--line-blue-dark);background:#F3FAFD;}
.btn.primary{background:var(--line-blue);border-color:var(--line-blue);color:#fff;}
.btn.primary:hover{background:var(--line-blue-dark);}
.btn.ghost{border-color:transparent;background:transparent;}
.btn:disabled{opacity:.45;cursor:default;}
.btn:disabled:hover{border-color:var(--border);color:var(--ink-2);background:#fff;}

.content{padding:22px 26px 60px;flex:1;}
.page{display:none;}
.page.active{display:block;animation:fadein .18s ease;}
@keyframes fadein{from{opacity:0;transform:translateY(3px);}to{opacity:1;transform:none;}}

.filters-bar{
  display:flex;gap:10px;flex-wrap:wrap;align-items:center;
  background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);
  padding:12px 14px;margin-bottom:16px;
}
.filter-group{display:flex;flex-direction:column;gap:4px;}
.filter-group label{font-size:10.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;}
.filter-group select, .filter-group input[type=text]{
  border:1px solid var(--border);border-radius:7px;padding:7px 10px;font-size:13px;color:var(--ink);
  background:#fff;min-width:130px;
}
.filter-group select:focus, .filter-group input:focus{outline:2px solid var(--line-blue);outline-offset:1px;}
.search-wrap{position:relative;margin-left:auto;}
.search-wrap svg{position:absolute;left:9px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:var(--muted);}
.search-wrap input{padding-left:29px !important;min-width:210px !important;}
.chips{display:flex;gap:6px;flex-wrap:wrap;}
.chip{
  border:1px solid var(--border);background:#fff;color:var(--ink-2);
  padding:6px 12px;border-radius:20px;font-size:12px;font-weight:600;
}
.chip:hover{border-color:var(--line-blue);}
.chip.active{background:var(--navy);border-color:var(--navy);color:#fff;}

.kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:16px;}
.kpi{
  background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);
  padding:14px 16px;position:relative;overflow:hidden;
}
.kpi::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--line-blue);}
.kpi .n{font-family:var(--font-d);font-size:26px;font-weight:700;color:var(--navy);font-variant-numeric:tabular-nums;}
.kpi .l{font-size:11.5px;color:var(--muted);font-weight:600;margin-top:2px;}
.kpi.gold::before{background:var(--gold);}
.kpi.f::before{background:#C15E86;}
.kpi.m::before{background:var(--line-blue);}

.panel{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;}
.table-wrap{overflow:auto;max-height:66vh;}
table.data{width:100%;border-collapse:collapse;font-size:13px;}
table.data thead th{
  position:sticky;top:0;background:#F7FAFB;border-bottom:1px solid var(--border);
  text-align:left;padding:10px 12px;font-size:11px;font-weight:700;color:var(--ink-2);
  text-transform:uppercase;letter-spacing:.03em;white-space:nowrap;cursor:pointer;user-select:none;z-index:2;
}
table.data thead th:hover{color:var(--line-blue-dark);}
table.data thead th .arrow{opacity:.4;margin-left:4px;font-size:10px;}
table.data thead th.sorted .arrow{opacity:1;color:var(--line-blue);}
table.data tbody td{padding:9px 12px;border-bottom:1px solid var(--border-2);white-space:nowrap;color:var(--ink);}
table.data tbody tr:hover{background:#F5FAFC;}
table.data tbody tr.gold td:first-child{box-shadow:inset 3px 0 0 var(--gold);}
table.data tbody tr.silver td:first-child{box-shadow:inset 3px 0 0 var(--silver);}
table.data tbody tr.bronze td:first-child{box-shadow:inset 3px 0 0 var(--bronze);}
table.data tbody tr.dq td{color:var(--warn);}
.mono{font-variant-numeric:tabular-nums;font-feature-settings:"tnum";}
.impr-good{color:var(--ok);font-weight:600;font-variant-numeric:tabular-nums;}
.impr-bad{color:var(--warn);font-weight:600;font-variant-numeric:tabular-nums;}
.tag{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:700;}
.tag.gold{background:#F5EAC7;color:#8A6B10;}
.tag.silver{background:#E9ECEE;color:#5A6670;}
.tag.bronze{background:#F1DFCB;color:#8A4E15;}
.tag.dq{background:#FBE4DC;color:var(--warn);}
.tag.ns{background:#EEF1F3;color:var(--muted);}
.tag.ok{background:#DFF3EA;color:var(--ok);}
.empty-state{padding:60px 20px;text-align:center;color:var(--muted);}
.empty-state svg{width:38px;height:38px;color:#B9C9D3;margin-bottom:10px;}
.empty-state b{color:var(--ink-2);display:block;margin-bottom:4px;font-size:14px;}
.loading-row{padding:40px;text-align:center;color:var(--muted);font-size:13px;}
.foot-note{padding:9px 14px;font-size:11.5px;color:var(--muted);border-top:1px solid var(--border-2);background:#FAFCFD;}

.col-toggles{display:flex;gap:12px;flex-wrap:wrap;align-items:center;font-size:12px;color:var(--ink-2);}
.col-toggles label{display:flex;align-items:center;gap:5px;font-weight:500;cursor:pointer;}

.section-title{font-family:var(--font-d);font-size:15px;font-weight:700;color:var(--navy);margin:22px 0 10px;}
.section-title:first-child{margin-top:0;}
.links-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px;margin-bottom:8px;}
.link-card{
  display:flex;align-items:center;gap:10px;background:var(--panel);border:1px solid var(--border);
  border-radius:var(--radius);padding:12px 14px;text-decoration:none;color:var(--ink);
}
.link-card:hover{border-color:var(--line-blue);background:#F5FAFC;}
.link-card .ic{width:34px;height:34px;border-radius:8px;background:#FBE9E4;color:var(--live);display:flex;align-items:center;justify-content:center;flex:0 0 34px;}
.link-card .tx b{display:block;font-size:13px;}
.link-card .tx span{font-size:11.5px;color:var(--muted);}

/* settings modal */
.modal-bg{position:fixed;inset:0;background:rgba(10,20,28,.5);display:none;align-items:center;justify-content:center;z-index:100;}
.modal-bg.show{display:flex;}
.modal{background:#fff;border-radius:12px;padding:22px;width:420px;max-width:92vw;max-height:86vh;overflow:auto;}
.modal h3{font-family:var(--font-d);margin:0 0 4px;color:var(--navy);}
.modal p{margin:0 0 16px;color:var(--muted);font-size:12.5px;}
.mrow{display:flex;flex-direction:column;gap:4px;margin-bottom:11px;}
.mrow label{font-size:11.5px;font-weight:700;color:var(--ink-2);}
.mrow input{border:1px solid var(--border);border-radius:7px;padding:8px 10px;font-size:13px;}
.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:14px;}

.hamburger-mobile{display:none;}
@media (max-width:880px){
  .sidebar{position:fixed;top:0;bottom:0;left:0;transform:translateX(-100%);width:240px;flex-basis:240px;box-shadow:0 0 30px rgba(0,0,0,.3);}
  .sidebar.mobile-open{transform:translateX(0);}
  .sidebar.collapsed{width:240px;flex-basis:240px;}
  .sidebar.collapsed .sb-title{display:block;}
  .sidebar.collapsed .nav-item span{display:inline;}
  .content{padding:16px;}
  .topbar{padding:12px 16px;}
}
</style>
</head>
<body>
<div class="app">

  <aside class="sidebar" id="sidebar">
    <div class="sb-head">
      <div class="sb-mark">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M2 17c1.5 1.3 3 1.3 4.5 0s3-1.3 4.5 0 3 1.3 4.5 0 3-1.3 4.5 0"/><path d="M2 12c1.5 1.3 3 1.3 4.5 0s3-1.3 4.5 0 3 1.3 4.5 0 3-1.3 4.5 0"/><circle cx="17" cy="5" r="2"/><path d="M11 9l-5 2 1.5 2.5"/></svg>
      </div>
      <div class="sb-title">Panel de Torneo<small>Resultados en vivo</small></div>
      <button class="sb-toggle" id="sbToggle" title="Contraer/expandir menú">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
    <nav class="nav" id="navList"></nav>
    <div class="sb-foot">
      <div class="live-row"><span class="dot" id="liveDot"></span><span id="liveLabel">Datos en vivo</span></div>
      <div id="lastUpdated" style="margin-bottom:10px;">Sin cargar aún</div>
      <button class="gear-btn" id="settingsBtn">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09A1.65 1.65 0 008.6 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H2a2 2 0 110-4h.09A1.65 1.65 0 003.6 8.6a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H8a1.65 1.65 0 001-1.51V2a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V8c.51.19 1.05.3 1.51 1H22a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
        Fuente de datos
      </button>
    </div>
  </aside>

  <div class="main">
    <div class="topbar">
      <div>
        <h1 id="pageTitle">Población</h1>
        <p id="pageSubtitle">Nadadores inscritos en el torneo</p>
      </div>
      <div class="toolbar">
        <button class="btn" id="btnRefresh">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
          Actualizar
        </button>
        <button class="btn" id="btnExcel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/></svg>Excel</button>
        <button class="btn" id="btnPdf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/></svg>PDF</button>
        <button class="btn" id="btnCopy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>Copiar</button>
      </div>
    </div>

    <div class="content" id="content">
      <!-- pages injected by JS -->
    </div>
  </div>
</div>

<div class="modal-bg" id="modalBg">
  <div class="modal">
    <h3>Fuente de datos</h3>
    <p>El panel lee en vivo la hoja de Google Sheets del torneo. Si alguna página aparece vacía, confirma aquí el nombre exacto de la pestaña correspondiente.</p>
    <div class="mrow"><label>ID de la hoja de cálculo</label><input id="cfgSheetId" type="text"></div>
    <div class="mrow"><label>Pestaña · Población (roster)</label><input id="cfgRoster" type="text"></div>
    <div class="mrow"><label>Pestaña · Resultados individuales</label><input id="cfgInd" type="text"></div>
    <div class="mrow"><label>Pestaña · Resultados relevos</label><input id="cfgRel" type="text"></div>
    <div class="mrow"><label>Pestaña · Categorías (edad → categoría)</label><input id="cfgCat" type="text"></div>
    <div class="mrow"><label>Pestaña · Programación (PDF)</label><input id="cfgProg" type="text"></div>
    <div class="mrow"><label>Pestaña · Informe</label><input id="cfgInforme" type="text"></div>
    <div class="modal-actions">
      <button class="btn ghost" id="cfgCancel">Cancelar</button>
      <button class="btn primary" id="cfgApply">Aplicar y recargar</button>
    </div>
  </div>
</div>

<script>
/* =====================================================================
   CONFIGURACIÓN
===================================================================== */
const CFG = {
  sheetId: '1P9seDPZXSESSk7CvMxgNlx2oM2w71bNrC1eA08Rcr2o',
  roster: 'Roster',
  rosterFallback: 'Lista',
  ind: 'Ind',
  rel: 'Rel',
  categorias: 'Categorias',
  programa: 'Programa',
  informe: 'Informe',
  baseInd: 'BaseInd',
  marcaTec: 'MarcaTec'
};
const CATEGORY_OPTIONS = ['Todas','Infantil A','Infantil B','Juvenil A','Juvenil B','Junior','Mayores','Abierta'];

/* =====================================================================
   UTILIDADES GENERALES
===================================================================== */
function norm(s){ return (s===undefined||s===null) ? '' : String(s).trim(); }
function stripAccents(s){ return norm(s).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,''); }
function escapeHtml(s){ return norm(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function isUrl(s){ return /^https?:\/\/\S+$/i.test(norm(s)); }

function csvUrl(tab){
  return `https://docs.google.com/spreadsheets/d/${CFG.sheetId}/gviz/tq?tqx=out:csv&sheet=${encodeURIComponent(tab)}`;
}

const cache = {};
async function fetchTab(tabName, force=false){
  if(cache[tabName] && !force) return cache[tabName];
  const res = await fetch(csvUrl(tabName), {cache:'no-store'});
  if(!res.ok) throw new Error('HTTP '+res.status+' al leer "'+tabName+'"');
  const text = await res.text();
  if(!text || /^\s*<(!doctype|html)/i.test(text)) throw new Error('La pestaña "'+tabName+'" no devolvió CSV (revisa el nombre o que la hoja sea pública).');
  const parsed = Papa.parse(text.trim(), {header:true, skipEmptyLines:true});
  const rows = (parsed.data||[]).map(r=>{
    const o = {};
    Object.keys(r).forEach(k=>{ o[norm(k)] = norm(r[k]); });
    return o;
  });
  cache[tabName] = rows;
  return rows;
}
async function fetchTabAny(names){
  let lastErr;
  for(const n of names){
    try{ const d = await fetchTab(n); return {name:n, rows:d}; }
    catch(e){ lastErr = e; }
  }
  throw lastErr || new Error('No se encontró ninguna de las pestañas: '+names.join(', '));
}
async function fetchTabSoft(name){
  try{ return await fetchTab(name); } catch(e){ return null; }
}

/* Parsing de valores tipo tiempo/numérico usados en Ind/Rel */
function findKey(row, candidates){
  const keys = Object.keys(row);
  for(const c of candidates){
    const hit = keys.find(k => stripAccents(k) === stripAccents(c));
    if(hit) return hit;
  }
  // coincidencia parcial
  for(const c of candidates){
    const hit = keys.find(k => stripAccents(k).includes(stripAccents(c)));
    if(hit) return hit;
  }
  return null;
}
function numOr(val, fallback){
  const n = parseFloat(norm(val).replace(',', '.'));
  return isNaN(n) ? fallback : n;
}
function statusFromFinal(finalVal){
  const v = stripAccents(finalVal).toUpperCase();
  if(v === 'DQ') return 'DQ';
  if(['NS','DNS','DNF','NO','NP'].includes(v)) return 'DNS';
  if(v === '' ) return 'PENDIENTE';
  return 'VALIDO';
}
function medalFromLugar(lugar){
  const n = parseInt(norm(lugar), 10);
  if(n === 1) return 'gold';
  if(n === 2) return 'silver';
  if(n === 3) return 'bronze';
  return '';
}

