    const marcaTec = await fetchTabSoft(CFG.marcaTec);

    const sample = rows[0];
    const genderKey = findKey(sample, ['genero','género','sexo']);
    const ageKey = findKey(sample, ['edad']);
    const nameKey = findKey(sample, ['nombre']);
    const pruebaKey = findKey(sample, ['prueba']);
    const equipoKey = findKey(sample, ['equipo']);
    const lugarKey = findKey(sample, ['lugar','puesto']);
    const finalKey = findKey(sample, ['final']);
    const mejoraKey = findKey(sample, ['mejora']);
    const puntosKey = findKey(sample, ['puntos']);
    const pwaKey = findKey(sample, ['pwa']);

    // merge best-effort de marcas mínimas / técnicas por Nombre+Prueba
    function lookupExtra(tab, valueKeyHints){
      if(!tab || !tab.length) return null;
      const s = tab[0];
      const nK = findKey(s, ['nombre']);
      const pK = findKey(s, ['prueba']);
      const vK = findKey(s, valueKeyHints);
      if(!nK || !vK) return null;
      const map = {};
      tab.forEach(r=>{ map[norm(r[nK])+'|'+(pK?norm(r[pK]):'')] = norm(r[vK]); });
      return {map, hasPrueba:!!pK};
    }
    const marcaMinLookup = lookupExtra(baseInd, ['marca minima','marca mínima','base']);
    const marcaTecLookup = lookupExtra(marcaTec, ['marca','tiempo','valor']);
    rows.forEach(r=>{
      r.__cat = classify(r, catMap, ageKey, genderKey);
      r.__status = finalKey ? statusFromFinal(r[finalKey]) : '';
      r.__medal = lugarKey ? medalFromLugar(r[lugarKey]) : '';
      const k = norm(r[nameKey])+'|'+(pruebaKey?norm(r[pruebaKey]):'');
      r.__marcaMin = marcaMinLookup ? (marcaMinLookup.map[k] ?? '') : '';
      r.__marcaTec = marcaTecLookup ? (marcaTecLookup.map[k] ?? '') : '';
    });

    el.innerHTML = `
      <div class="filters-bar">
        ${genderKey?`<div class="filter-group"><label>Género</label><select id="posGenero"><option value="">Todos</option><option>Femenino</option><option>Masculino</option></select></div>`:''}
        <div class="filter-group"><label>Categoría</label><select id="posCategoria"></select></div>
        ${ageKey?`<div class="filter-group"><label>Edad</label><select id="posEdad"></select></div>`:''}
        <div class="filter-group"><label>Estado</label>
          <div class="chips" id="posEstadoChips">
            <button class="chip active" data-v="">Todos</button>
            <button class="chip" data-v="medalla">Con medalla</button>
            <button class="chip" data-v="DQ">DQ</button>
            <button class="chip" data-v="DNS">DNS/DNF/NS</button>
          </div>
        </div>
        <div class="search-wrap">${icon('search')}<input type="text" id="posSearch" placeholder="Buscar nadador, equipo o prueba…"></div>
      </div>
      <div class="filters-bar col-toggles">
        <span style="font-weight:700;color:var(--ink-2);">Mostrar columnas:</span>
        <label><input type="checkbox" id="colPWA" checked> Puntos WA</label>
        <label><input type="checkbox" id="colMejora" checked> % Mejora</label>
        <label><input type="checkbox" id="colMarcaMin" ${marcaMinLookup?'checked':''} ${marcaMinLookup?'':'disabled'}> Marcas mínimas</label>
        <label><input type="checkbox" id="colMarcaTec" ${marcaTecLookup?'checked':''} ${marcaTecLookup?'':'disabled'}> Marca técnica</label>
      </div>
      <div class="panel"><div id="posTable"></div>
        <div class="foot-note">Fuente: pestaña “${escapeHtml(name)}”${marcaMinLookup?` + “${CFG.baseInd}”`:''}${marcaTecLookup?` + “${CFG.marcaTec}”`:''} · ${rows.length} registros.</div>
      </div>`;

    populateCategoryOptions(document.getElementById('posCategoria'));
    if(ageKey) populateAgeOptions(document.getElementById('posEdad'), rows, ageKey);

    let estadoFilter = '';
    document.querySelectorAll('#posEstadoChips .chip').forEach(ch=>{
      ch.addEventListener('click', ()=>{
        document.querySelectorAll('#posEstadoChips .chip').forEach(c=>c.classList.remove('active'));
        ch.classList.add('active'); estadoFilter = ch.dataset.v; apply();
      });
    });

    const sortState = {key: puntosKey || lugarKey || nameKey, dir:'desc'};
    function apply(){
      let filtered = [...rows];
      if(genderKey){ const g = document.getElementById('posGenero').value; if(g) filtered = filtered.filter(r=>norm(r[genderKey])===g); }
      const c = document.getElementById('posCategoria').value; if(c) filtered = filtered.filter(r=>r.__cat===c);
      if(ageKey){ const a = document.getElementById('posEdad').value; if(a) filtered = filtered.filter(r=>norm(r[ageKey])===a); }
      if(estadoFilter==='medalla') filtered = filtered.filter(r=>r.__medal);
      else if(estadoFilter) filtered = filtered.filter(r=>r.__status===estadoFilter);
      const q = stripAccents(document.getElementById('posSearch').value);
      if(q) filtered = filtered.filter(r=> Object.values(r).some(v=>stripAccents(v).includes(q)));

      const showPWA = document.getElementById('colPWA').checked;
      const showMejora = document.getElementById('colMejora').checked;
      const showMarcaMin = document.getElementById('colMarcaMin').checked && marcaMinLookup;
      const showMarcaTec = document.getElementById('colMarcaTec').checked && marcaTecLookup;

      const columns = [];
      if(lugarKey) columns.push({key:lugarKey, label:'Lugar', numeric:true, mono:true, render:(v,r)=>{
        if(r.__medal==='gold') return `<span class="tag gold">🥇 ${escapeHtml(v)}</span>`;
        if(r.__medal==='silver') return `<span class="tag silver">🥈 ${escapeHtml(v)}</span>`;
        if(r.__medal==='bronze') return `<span class="tag bronze">🥉 ${escapeHtml(v)}</span>`;
        return escapeHtml(v);
      }});
      columns.push({key:nameKey, label:'Nombre'});
      if(equipoKey) columns.push({key:equipoKey, label:'Equipo'});
      if(genderKey) columns.push({key:genderKey, label:'Género'});
      columns.push({key:'__cat', label:'Categoría'});
      if(pruebaKey) columns.push({key:pruebaKey, label:'Prueba'});
      if(finalKey) columns.push({key:finalKey, label:'Resultado', mono:true, render:(v,r)=>{
        if(r.__status==='DQ') return `<span class="tag dq">DQ</span>`;
        if(r.__status==='DNS') return `<span class="tag ns">${escapeHtml(v)}</span>`;
        return `<span class="mono">${escapeHtml(v)}</span>`;
      }});
      if(showMejora && mejoraKey) columns.push({key:mejoraKey, label:'% Mejora', numeric:true, mono:true});
      if(puntosKey) columns.push({key:puntosKey, label:'Puntos torneo', numeric:true, mono:true});
      if(showPWA && pwaKey) columns.push({key:pwaKey, label:'Puntos WA', numeric:true, mono:true});
      if(showMarcaMin) columns.push({key:'__marcaMin', label:'Marca mínima', mono:true});
      if(showMarcaTec) columns.push({key:'__marcaTec', label:'Marca técnica', mono:true});

      filtered = sortRows(filtered, sortState.key, sortState.dir, columns);
      buildDataTable(document.getElementById('posTable'), {
        rows:filtered, columns, sortKey:sortState.key, sortDir:sortState.dir,
        rowClassFn:(r)=>{ const cls=[]; if(r.__medal) cls.push(r.__medal); if(r.__status==='DQ') cls.push('dq'); return cls.join(' '); },
        onSort:(k)=>{ sortState.dir=(sortState.key===k && sortState.dir==='asc')?'desc':'asc'; sortState.key=k; apply(); }
      });
      setExport(filtered, columns, 'tabla_posiciones');
    }
    ['posGenero','posCategoria','posEdad','posSearch','colPWA','colMejora','colMarcaMin','colMarcaTec'].forEach(id=>{
      const elm = document.getElementById(id);
      if(elm){ elm.addEventListener('input', apply); elm.addEventListener('change', apply); }
    });
    apply();
  }catch(e){
    el.innerHTML = errorBlock('tabla de posiciones', [CFG.ind], e);
  }
}

/* =====================================================================
   PÁGINA: INFORMES / PROGRAMACIÓN
===================================================================== */
async function renderInformes(){
  const el = document.getElementById('page-informes');
  el.innerHTML = `<div class="loading-row">Cargando informes…</div>`;
  let html = '';
  let anyRows = []; let anyCols = [];

  const prog = await fetchTabSoft(CFG.programa);
  html += `<div class="section-title">Programación de competencia</div>`;
  if(prog && prog.length){
    const sample = prog[0];
    const linkKeys = Object.keys(sample).filter(k => prog.some(r=>isUrl(r[k])));
    const labelKey = findKey(sample, ['sesion','sesión','jornada','dia','día','nombre','titulo','título']) || Object.keys(sample)[0];
    if(linkKeys.length){
      html += '<div class="links-grid">';
      prog.forEach(r=>{
        linkKeys.forEach(lk=>{
          const url = r[lk];
          if(isUrl(url)){
            const label = norm(r[labelKey]) || lk;
            html += `<a class="link-card" href="${escapeHtml(url)}" target="_blank" rel="noopener">
              <div class="ic">${icon('doc')}</div>
              <div class="tx"><b>${escapeHtml(label)}</b><span>${escapeHtml(lk)} · Ver PDF</span></div>
            </a>`;
          }
        });
      });
      html += '</div>';
    } else {
      html += `<div class="panel"><div id="progTable"></div></div>`;
    }
    anyRows = prog; anyCols = Object.keys(sample).map(k=>({key:k,label:k}));
  } else {
    html += `<div class="empty-state">${icon('empty')}<b>No se encontró la pestaña de programación</b>Verifica el nombre en “Fuente de datos” (se intentó “${escapeHtml(CFG.programa)}”).</div>`;
  }

  const informe = await fetchTabSoft(CFG.informe);
  html += `<div class="section-title">Informe general</div>`;
  if(informe && informe.length){
    html += `<div class="panel"><div id="informeTable"></div></div>`;
  } else {
    html += `<div class="empty-state" style="padding:30px;">${icon('empty')}<b>No se encontró la pestaña “${escapeHtml(CFG.informe)}”</b>Puedes ajustar el nombre en “Fuente de datos”.</div>`;
  }

  el.innerHTML = html;

  if(prog && prog.length){
    const cols = Object.keys(prog[0]).map(k=>({key:k, label:k, render:(v)=> isUrl(v) ? `<a href="${escapeHtml(v)}" target="_blank" rel="noopener">Abrir ↗</a>` : escapeHtml(v)}));
    const tEl = document.getElementById('progTable');
    if(tEl) buildDataTable(tEl, {rows:prog, columns:cols, sortKey:cols[0].key, sortDir:'asc', onSort:()=>{}});
  }
  if(informe && informe.length){
    const cols = Object.keys(informe[0]).map(k=>({key:k, label:k}));
    buildDataTable(document.getElementById('informeTable'), {rows:informe, columns:cols, sortKey:cols[0].key, sortDir:'asc', onSort:()=>{}});
    setExport(informe, cols, 'informe');
  } else if(prog && prog.length){
    const cols = Object.keys(prog[0]).map(k=>({key:k, label:k}));
    setExport(prog, cols, 'programacion');
  } else {
    setExport([], [], 'informes');
  }
}

/* =====================================================================
   MANEJO DE ERRORES
===================================================================== */
function errorBlock(pagina, tabs, e){
  return `<div class="empty-state">${icon('empty')}
    <b>No se pudo cargar “${escapeHtml(pagina)}”</b>
    ${escapeHtml(e && e.message ? e.message : 'Error desconocido')}<br><br>
    Pestaña(s) intentada(s): ${tabs.map(t=>'“'+escapeHtml(t)+'”').join(', ')}.<br>
    Verifica el nombre exacto en el botón “Fuente de datos” del menú, y que la hoja esté compartida como “Cualquier persona con el enlace puede ver”.
  </div>`;
}

/* =====================================================================
   RENDER ROUTER + AUTO-REFRESH
===================================================================== */
function renderCurrentPage(force=false){
  switch(STATE.currentPage){
    case 'poblacion': return renderPoblacion(force);
    case 'individuales': return renderResultados('ind');
    case 'relevos': return renderResultados('rel');
    case 'posiciones': return renderPosiciones();
    case 'informes': return renderInformes();
  }
}
function touchUpdated(){
  document.getElementById('lastUpdated').textContent = 'Actualizado: ' + new Date().toLocaleTimeString('es-CO');
}
document.getElementById('btnRefresh').addEventListener('click', async ()=>{
  Object.keys(cache).forEach(k=>delete cache[k]);
  STATE.categoriaMap = null;
  await renderCurrentPage(true);
  touchUpdated();
});

/* =====================================================================
   MODAL DE CONFIGURACIÓN
===================================================================== */
function openModal(){
  document.getElementById('cfgSheetId').value = CFG.sheetId;
  document.getElementById('cfgRoster').value = CFG.roster;
  document.getElementById('cfgInd').value = CFG.ind;
  document.getElementById('cfgRel').value = CFG.rel;
  document.getElementById('cfgCat').value = CFG.categorias;
  document.getElementById('cfgProg').value = CFG.programa;
  document.getElementById('cfgInforme').value = CFG.informe;
  document.getElementById('modalBg').classList.add('show');
}
document.getElementById('settingsBtn').addEventListener('click', openModal);
document.getElementById('cfgCancel').addEventListener('click', ()=> document.getElementById('modalBg').classList.remove('show'));
document.getElementById('cfgApply').addEventListener('click', async ()=>{
  CFG.sheetId = norm(document.getElementById('cfgSheetId').value) || CFG.sheetId;
  CFG.roster = norm(document.getElementById('cfgRoster').value) || CFG.roster;
  CFG.ind = norm(document.getElementById('cfgInd').value) || CFG.ind;
  CFG.rel = norm(document.getElementById('cfgRel').value) || CFG.rel;
  CFG.categorias = norm(document.getElementById('cfgCat').value) || CFG.categorias;
  CFG.programa = norm(document.getElementById('cfgProg').value) || CFG.programa;
  CFG.informe = norm(document.getElementById('cfgInforme').value) || CFG.informe;
  Object.keys(cache).forEach(k=>delete cache[k]);
  STATE.categoriaMap = null;
  document.getElementById('modalBg').classList.remove('show');
  await renderCurrentPage(true);
  touchUpdated();
});

/* =====================================================================
   INICIO
===================================================================== */
function buildPages(){
  const content = document.getElementById('content');
  content.innerHTML = PAGES.map(p => `<div class="page ${p.id===STATE.currentPage?'active':''}" id="page-${p.id}"></div>`).join('');
}
async function init(){
  buildNav();
  buildPages();
  await renderCurrentPage();
  touchUpdated();
  STATE.refreshTimer = setInterval(async ()=>{
    if(!STATE.autoRefresh) return;
    Object.keys(cache).forEach(k=>delete cache[k]);
    await renderCurrentPage(true);
    touchUpdated();
  }, 45000);
}
init();
</script>
