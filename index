/* =====================================================================
   CATEGORÍAS: mapa Edad(+Género) -> Categoría
===================================================================== */
async function ensureCategoriaMap(){
  if(STATE.categoriaMap) return STATE.categoriaMap;
  const map = {byAgeGender:{}, byAge:{}, ok:false};
  const rows = await fetchTabSoft(CFG.categorias);
  if(rows && rows.length){
    const sample = rows[0];
    const ageKey = findKey(sample, ['edad']);
    const catKey = findKey(sample, ['categoria','categoría']);
    const genKey = findKey(sample, ['genero','género','sexo']);
    if(ageKey && catKey){
      rows.forEach(r=>{
        const age = norm(r[ageKey]);
        const cat = norm(r[catKey]);
        if(!age || !cat) return;
        if(genKey && norm(r[genKey])){
          map.byAgeGender[age+'|'+norm(r[genKey])] = cat;
        } else {
          map.byAge[age] = cat;
        }
      });
      map.ok = true;
    }
  }
  STATE.categoriaMap = map;
  return map;
}
function classify(row, map, ageKey, genderKey){
  // 1) si la propia fila ya trae categoría, úsala
  const directKey = findKey(row, ['categoria','categoría']);
  if(directKey && norm(row[directKey])) return norm(row[directKey]);
  if(!map || !map.ok) return '';
  const age = norm(row[ageKey]);
  const gender = genderKey ? norm(row[genderKey]) : '';
  if(gender && map.byAgeGender[age+'|'+gender]) return map.byAgeGender[age+'|'+gender];
  if(map.byAge[age]) return map.byAge[age];
  return '';
}

